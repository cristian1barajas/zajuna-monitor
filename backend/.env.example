# Zajuna Credentials (NEVER commit the real .env)
ZAJUNA_BASE_URL=https://zajuna.sena.edu.co
ZAJUNA_TYPE_DOCUMENT=CC
ZAJUNA_DOCUMENT=XXXXXXXXXX
ZAJUNA_PASSWORD=XXXXXXXXXX

# Course IDs to scrape (comma separated)
# Mapping: courseId -> ficha SENA
#   14897 -> 2977396
#   14903 -> 2977397
#   89977 -> 3388997
#   89967 -> 3388998
#   89964 -> 3389000
ZAJUNA_COURSE_IDS=14897,14903,89977,89967,89964

# Scraper settings
MIN_DELAY=2.0
MAX_DELAY=5.0
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO

# Shared CMM identity (required: the API does not start without it)
# Must match JWT_SECRET_KEY / JWT_ALGORITHM in sena-dev-2026-backend.
# At least 32 random bytes. Generate it in both .env files with:
#   powershell -File scripts/generar_secreto_jwt.ps1
CMM_JWT_SECRET_KEY=
CMM_JWT_ALGORITHM=HS256

# Security
# development | production. Production turns off /docs, adds HSTS and turns
# off the local tools (Outlook supports, phone folder import, evidence
# downloads to a server folder).
APP_ENV=development
# Allowed browser origins (comma separated). Production: only the frontend domain.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Max request body (MB) and requests per minute per user on /api (0 = no limit).
MAX_BODY_MB=30
RATE_LIMIT_PER_MINUTE=600
# Override the default for local tools (true in development, false in production).
# LOCAL_TOOLS_ENABLED=

# Credential vault
# Development: leave unset to create backend/data/.cred_key automatically.
# Production: set a valid Fernet key and keep a secure backup.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ZAJUNA_CRED_KEY=

# Monitor API settings
# API_KEY is legacy; JWT CMM is the primary API authentication.
API_KEY=change-this-to-a-secure-random-string
API_HOST=127.0.0.1
API_PORT=8000
